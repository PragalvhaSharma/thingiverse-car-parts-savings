# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# Then run   python script/doctor.py   to check every value before a run.
# Lines left empty use the default shown in the comment.

# ---------------------------------------------------------------- OpenAI
# Steps 1-3: the classifier, the matcher and the judge.
OPENAI_API_KEY=
# The paper's model ("OpenAI's GPT-5.6 Luna, used for every AI step").
OPENAI_MODEL=gpt-5.6-luna
# Optional: minimal | low | medium | high. Empty = the model's default.
OPENAI_REASONING_EFFORT=
# Detail level of the photos sent to the model: auto | low | high
OPENAI_IMAGE_DETAIL=auto

# ---------------------------------------------------------------- Thingiverse
# The harvest reads the website with a signed-in browser's cookies, as in the paper.
# Chrome, signed in to thingiverse.com: open any Thing page, DevTools (Cmd+Opt+I) >
# Network > reload > click the first request (thing:<id>) > Request Headers >
# copy the whole value of "cookie". It must contain cf_clearance.
THINGIVERSE_COOKIE=
# Optional: leave it empty. The harvest reads each Thing through the website's own JSON
# route with the visitor token the site gives every browser (description, photos, print
# settings, model files). A signed-in token only adds download counts, for an input sheet
# without a Downloads column (Romain's sheet, the Prius sheet and the examples have one).
# To set it: in the same DevTools tab, filter by "/api/", click any request and copy its
# "authorization" header without the word "Bearer ". The doctor shows when it expires.
THINGIVERSE_WEB_TOKEN=
# Optional: a Thingiverse developer-app token. Used for download counts the website does
# not give (only needed for inputs without them; Romain's sheet and the Prius sheet have
# them) and for model files whose download link points at api.thingiverse.com.
THINGIVERSE_TOKEN=

# ---------------------------------------------------------------- eBay
# Step 3 searches eBay's public website. Recommended: a browser session's cookies. On
# ebay.com (or ebay.ca) run any search or open any listing, and copy the "cookie" request
# header the same way as above.
EBAY_COOKIE=
# Extra query string added to every search URL. Empty = _fcid=1&_stpos=10001, which sets
# the ship-to to New York (ZIP 10001) so prices come back in US dollars, from Canada too.
# "none" adds nothing.
EBAY_EXTRA_PARAMS=
# The "user-agent" request header of the browser the cookies came from. Cloudflare ties
# cf_clearance to it. Empty = a recent desktop Chrome on macOS. Requests also need
# Chrome's TLS handshake (curl_cffi, in requirements.txt): without it Cloudflare and eBay
# challenge them whatever the cookies.
BROWSER_USER_AGENT=
# Seconds between two requests to the same host (default 1.5).
HTTP_DELAY=1.5

# ---------------------------------------------------------------- OrcaSlicer
# Step 4. mcp: the orcaslicer-mcp connector drives OrcaSlicer, as in the paper.
#         rest: the pipeline calls OrcaSlicer's Remote API itself.
#         none: no slicer; grams are estimated from each file's geometry.
# python pipeline.py --skip-slice skips step 4 altogether (flat $0.75 per print).
SLICER_BACKEND=mcp
ORCA_MCP_COMMAND=uvx orcaslicer-mcp
# OrcaSlicer > Preferences > Remote API: turn it on and copy the token.
ORCA_API_TOKEN=
ORCA_API_URL=http://127.0.0.1:13130
# Seconds allowed for one slice.
ORCA_SLICE_TIMEOUT=600

# ---------------------------------------------------------------- step 5
# The Sep 2 values. PLA price, printer bed (longest printable part, mm), the scale
# guard ($ of listing price per gram of plastic) and the grams assumed when a Thing
# has no sliceable file.
PLA_USD_PER_KG=25
BED_MM=256
SCALE_USD_PER_G=100
DEFAULT_GRAMS=30

# ---------------------------------------------------------------- cache
# Where each stage's results are kept between runs. Empty = ./cache
CACHE_DIR=
